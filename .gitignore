.DS_Store
**/.DS_Store

# Исходники промо: сайт показывает только собранные версии из source/img/promo/,
# а оригиналы весят ~100 МБ. Хранятся локально, в репозиторий не идут.
promo-web/*
promo-project/*
# order.txt задаёт порядок материалов на сайте — его храним
!promo-web/*/
!promo-project/*/
promo-web/*/*
promo-project/*/*
!promo-web/*/order.txt
!promo-project/*/order.txt
__pycache__/

# Оригиналы случайных фото для главной: ~150 МБ и GPS-метки в EXIF.
# На сайт идут только собранные webp из source/img/random/ (без метаданных).
imgfromgallery/

# Локальные заметки по устройству сайта
NOTES.md
